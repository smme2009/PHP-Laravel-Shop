{
    "openapi": "3.0.0",
    "info": {
        "title": "商城 API",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "帳號"
                ],
                "summary": "登入",
                "description": "使用者登入",
                "operationId": "login",
                "requestBody": {
                    "description": "登入資料",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "account",
                                    "password",
                                    "roleId"
                                ],
                                "properties": {
                                    "account": {
                                        "description": "帳號",
                                        "type": "string",
                                        "example": "test@test.com"
                                    },
                                    "password": {
                                        "description": "密碼",
                                        "type": "string",
                                        "example": "password"
                                    },
                                    "roleId": {
                                        "description": "角色ID",
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "登入成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "登入成功"
                                        },
                                        "data": {
                                            "properties": {
                                                "jwtToken": {
                                                    "type": "string",
                                                    "example": "text.text.text"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "登入失敗",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "登入失敗，{錯誤資訊}"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "帳號",
            "description": "帳號"
        }
    ]
}